# Supabase — from the project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_DB_PASSWORD=YOUR-DB-PASSWORD

# Canonical site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Email (Phase 4)
RESEND_API_KEY=
EMAIL_FROM=Perch <jobs@yourdomain.com>


# Optional: overrides the address seeded into admin_emails
SEED_ADMIN_EMAIL=you@example.com

# AI fit score on job detail pages (Anthropic Messages API) — optional, degrades
# gracefully: with no key set, seekers just don't see a match score.
ANTHROPIC_API_KEY=

# Shared secret for the Vercel Crons (/api/alerts/run, /api/cron/demo-reset).
# Required in production: without it both endpoints refuse to run rather than
# letting an unauthenticated caller email every seeker, or reset the demo.
CRON_SECRET=

# Portfolio demo mode: "Try the demo" one-click sign-in on /login, the demo
# banner, and the daily reset. Set to true to turn it on. Inlined at build
# time, so redeploy after changing it.
NEXT_PUBLIC_DEMO_MODE=
# Passwords for the two shared demo logins (demo-seeker@ and
# demo-recruiter@seed.perch.test). Server-only: never prefix them with
# NEXT_PUBLIC_. Use long random values; nobody types them.
DEMO_SEEKER_PASSWORD=
DEMO_RECRUITER_PASSWORD=
